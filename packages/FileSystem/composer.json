{
  "name": "skislemleko11/velo-filesystem",
  "description": "FileSystem package for Velo framework",
  "type": "library",
  "license": "LGPL-3.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5"
  },
  "autoload": {
    "psr-4": {
      "Velo\\FileSystem\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "autoload-dev": {
    "psr-4": {
      "Velo\\FileSystem\\Tests\\": "tests/"
    }
  }
}