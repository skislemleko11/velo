{
  "name": "skislemleko11/velo-http",
  "description": "HTTP package for Velo framework",
  "type": "library",
  "license": "LGPL-3.0",
  "require": {
    "php": ">=8.5",
    "skislemleko11/velo-exceptions" : "*",
    "skislemleko11/velo-session": "*",
    "skislemleko11/velo-view": "*"
  },
  "autoload": {
    "psr-4": {
      "Velo\\Http\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "autoload-dev": {
    "psr-4": {
      "Velo\\Http\\Tests\\": "tests/"
    }
  }
}