{
  "name": "Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.5-bookworm",
  
  "features": {
    "ghcr.io/devcontainers/features/php-packages:1": {
      "packages": "pdo_mysql,pdo_sqlite,sqlite3"
    },
    "ghcr.io/devcontainers-extra/features/sqlite3:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "qwtel.sqlite-viewer",
        "mtxr.sqltools"
      ]
    }
  },

  "remoteUser": "vscode"
}
